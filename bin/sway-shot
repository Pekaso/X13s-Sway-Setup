#!/bin/sh
set -eu
dir="$HOME/Pictures/Screenshots"
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S)-$$.png"
if [ "${1:-}" = region ]; then
    geometry=$(slurp) || exit 0
    grim -g "$geometry" "$file"
else
    grim "$file"
fi
wl-copy --type image/png < "$file"
notify-send 'Screenshot saved + copied' "$file"
